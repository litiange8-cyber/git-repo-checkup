# 复制本文件为 .env 并填入你的 DeepSeek API Key
DEEPSEEK_API_KEY=sk-你的密钥

# 可选：自定义 DeepSeek 接口地址与模型
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# 服务端安全配置（公网部署时建议配置）
# API_TOKEN=your-random-token          # 配置后 analyze 接口需 Bearer 鉴权
# CORS_ORIGINS=https://your-domain.com # 允许的来源，逗号分隔
# RATE_LIMIT_PER_MIN=10                # 单 IP 每分钟请求上限
# MAX_CONCURRENT_ANALYSIS=3            # 并发分析上限
# REPORT_TTL_SEC=3600                  # 报告缓存有效期
# MAX_REPO_SIZE_MB=100                 # 单仓库体积上限
